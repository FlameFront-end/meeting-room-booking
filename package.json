{
	"name": "meeting-room-booking",
	"version": "0.1.0",
	"private": true,
	"description": "Бронирование переговорной комнаты в течение рабочего дня (тестовое задание)",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "next typegen && tsc --noEmit",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"lint:styles": "stylelint \"src/**/*.{css,scss}\" \"app/**/*.{css,scss}\"",
		"lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" \"app/**/*.{css,scss}\" --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"check": "npm run typecheck && npm run lint && npm run lint:styles && npm run format:check && npm run test",
		"prepare": "husky"
	},
	"dependencies": {
		"@hookform/resolvers": "5.9.2",
		"@tanstack/react-query": "5.107.1",
		"clsx": "2.1.1",
		"msw": "2.15.0",
		"next": "16.4.5",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.91.0",
		"sonner": "2.0.8",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "9.39.5",
		"@playwright/test": "1.65.0",
		"@tanstack/eslint-plugin-query": "5.107.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-testing-library": "7.16.2",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"sass": "1.108.1",
		"stylelint": "17.16.0",
		"stylelint-config-recess-order": "7.10.0",
		"stylelint-config-standard-scss": "17.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
